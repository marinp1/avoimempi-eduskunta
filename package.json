{
  "name": "eduskunta-forum",
  "version": "1.1.0-alpha.1",
  "type": "module",
  "private": true,
  "author": "",
  "license": "ISC",
  "description": "Data aggregation and analysis platform for Finnish Parliament",
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.9",
    "@mui/material": "7.3.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-sqlite-migrations": "1.0.2",
    "fast-xml-parser": "5.5.7",
    "i18next": "26.0.1",
    "postgres": "3.4.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "17.0.1",
    "recharts": "3.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "@types/bun": "1.3.8",
    "@types/node": "22.13.4",
    "@typescript/native-preview": "7.0.0-dev.20260330.1"
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "start": "NODE_ENV=development bun run packages/server/index.ts",
    "deploy": "bun scripts/deploy.mts all",
    "deploy:app": "bun scripts/deploy.mts app",
    "deploy:pipeline": "bun scripts/deploy.mts pipeline",
    "deploy:db": "bun scripts/deploy.mts database",
    "fetch-counts": "cd packages/datapipe && bun run scraper/fetch-counts-cli.ts",
    "history": "cd packages/datapipe && bun run scraper/history-cli.ts",
    "scrape": "cd packages/datapipe && bun run scraper/cli.ts",
    "parse": "cd packages/datapipe && bun run parser/cli.ts",
    "migrate": "cd packages/datapipe && bun run migrator/cli.ts",
    "migrate:fresh": "cd packages/datapipe && bun run migrator/cli.ts recreate",
    "rowstore:compact": "bun run scripts/compact-row-stores.ts",
    "test": "bun test",
    "bench:sql": "bun run packages/server/scripts/benchmark-query-latency.ts",
    "bench:http": "bun run packages/server/scripts/benchmark-http-load.ts",
    "lint": "bunx biome check",
    "lint:fix": "bunx biome check --write",
    "check:table-coverage": "bun run scripts/check-table-coverage-vs-api.ts",
    "release": "bun run scripts/release.ts",
    "release:minor": "bun run scripts/release.ts minor",
    "release:major": "bun run scripts/release.ts major"
  }
}
