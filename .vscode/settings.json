{
  "editor.formatOnSave": true,
  "files.insertFinalNewline": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "files.associations": {
    "*.eta": "html"
  },
  "html.customData": [".vscode/htmx-custom-data.json"],
  "[html]": {
    "editor.formatOnSave": false
  },
  "css.styleSheets": [
    "packages/webapp/src/styles/*.css",
    "packages/webapp/src/styles.css"
  ],
  "yaml.schemas": {
    "./packages/server/config/sanity-constraints.schema.json": "packages/server/config/sanity-constraints.yaml"
  }
}
