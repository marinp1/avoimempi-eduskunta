<!DOCTYPE html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= it.title ? it.title + ' — Eduskuntapeili' : 'Eduskuntapeili' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/webapp/styles.css<%= it.assetVersion ? '?v=' + it.assetVersion : '' %>" />
    <script src="/webapp/setup.js<%= it.assetVersion ? '?v=' + it.assetVersion : '' %>" defer></script>
  </head>
  <body>
    <div class="wrap">
      <header class="masthead">
        <%~ include("./partials/masthead", it) %>
      </header>
    </div>
    <main id="main-content">
      <%~ it.content %>
    </main>
    <div class="wrap">
      <%~ include("./partials/footer", it) %>
    </div>
  </body>
</html>
